<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The Dropbox sign-in stays on this phone: it is not copied to Google's cloud backup or to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dropbox.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dropbox.xml" />
    </device-transfer>
</data-extraction-rules>
